{
  "name": "rhythm-master",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser-based rhythm and melody practice and composition tool",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "coverage:ac": "node tests/ac-coverage.js",
    "check:trace": "node .claude/skills/spec-trace/spec-trace.mjs",
    "validate:seed": "node tools/validate-seed.js",
    "check:cvd": "node tools/check-cvd.js",
    "lint": "eslint .",
    "trace:matrix": "node .claude/skills/spec-trace/spec-trace.mjs matrix",
    "trace:changed": "node .claude/skills/spec-trace/spec-trace.mjs changed",
    "trace:prune": "node .claude/skills/spec-trace/spec-trace.mjs prune-baseline"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
